rule aggregate_gsea_across_contrasts:
  input:
    # Order matters: gsea_summary.R pairs these positionally with
    # `group_names` (CONTRAST_NAMES). Only `contrast` varies in this expand().
    gsea_tables = lambda wc: expand(
      rules.gsea_postprocess_go.output.gsea_table_all,
      contrast=CONTRAST_NAMES, gsea=wc.gsea,
      confounder_handling=wc.confounder_handling
    ),
    plot_theme_lib = rules.plot_pca.input.plot_theme_lib,
    heatmap_theme_lib = rules.pc_field_association.input.heatmap_theme_lib,
    plot_title_lib = rules.plot_volcano.input.plot_title_lib,
    # ^-- explicitly re-run upon code change
  output:
    summary_table =
      f"{OUTPUT_DIR}/gsea/{{gsea}}.{{confounder_handling}}.gsea_summary.tsv.gz",
    heatmap =
      f"{OUTPUT_DIR}/gsea/{{gsea}}.{{confounder_handling}}.gsea_summary_heatmap.pdf",
    jaccard =
      f"{OUTPUT_DIR}/gsea/{{gsea}}.{{confounder_handling}}.gsea_jaccard.tsv.gz",
  params:
    grouping_var = "contrast",
    group_names = CONTRAST_NAMES,
    rank_heuristic = "breadth",
    gsea_name = rules.gsea_postprocess_go.params.gsea_name,
    padj_threshold = rules.gsea_postprocess_go.params.padj_threshold,
    gene_sets_of_interest =
      rules.gsea_postprocess_go.params.gene_sets_of_interest,
    heatmap_top_n = HEATMAP_TOP_N,
    color_up = rules.plot_volcano.params.color_up,
    color_down = rules.plot_volcano.params.color_down,
    color_none = rules.plot_volcano.params.color_none,
    color_na = config["colors"]["direction"].get("na", "grey90"),
  log: f"{OUTPUT_DIR}/logs/gsea_{{gsea}}.{{confounder_handling}}.aggregate.log"
  conda: "envs/gsea_summary.yaml"
  script: "scripts/gsea_summary.R"

use rule aggregate_gsea_across_contrasts as aggregate_gsea_by_confounder_handling with:
  input:
    # Fixed contrast + gsea, expanded over every active confounder-handling
    # strategy -- the inverse of the base rule's expand. `input` is
    # replaced, not merged, so every input of the base rule is restated.
    gsea_tables = lambda wc: expand(
      rules.gsea_postprocess_go.output.gsea_table_all,
      contrast=wc.contrast, gsea=wc.gsea,
      confounder_handling=ACTIVE_CONFOUNDER_HANDLING_METHODS
    ),
    plot_theme_lib = rules.aggregate_gsea_across_contrasts.input.plot_theme_lib,
    # ^-- explicitly re-run upon code change
    heatmap_theme_lib = rules.aggregate_gsea_across_contrasts.input.heatmap_theme_lib,
    # ^-- explicitly re-run upon code change
    plot_title_lib = rules.aggregate_gsea_across_contrasts.input.plot_title_lib,
    # ^-- explicitly re-run upon code change
  output:
    summary_table =
      f"{OUTPUT_DIR}/gsea/{{contrast}}.{{gsea}}.confounder_handling_comparison.gsea_summary.tsv.gz",
    heatmap =
      f"{OUTPUT_DIR}/gsea/{{contrast}}.{{gsea}}.confounder_handling_comparison.gsea_summary_heatmap.pdf",
    jaccard =
      f"{OUTPUT_DIR}/gsea/{{contrast}}.{{gsea}}.confounder_handling_comparison.gsea_jaccard.tsv.gz",
  params:
    grouping_var = "confounder_handling",
    group_names = ACTIVE_CONFOUNDER_HANDLING_METHODS,
    rank_heuristic = "divergence",  # overrides the base rule's "breadth"
    contrast_name = "{contrast}",   # new param; unset on the base rule
    gsea_name = rules.aggregate_gsea_across_contrasts.params.gsea_name,
    padj_threshold =
      rules.aggregate_gsea_across_contrasts.params.padj_threshold,
