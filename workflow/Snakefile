    gsea_ridge_plot =
      f"{OUTPUT_DIR}/gsea/{{contrast}}.{{confounder_handling}}.{{gsea}}_gsea_ridge_plot.pdf",
    gsea_lollipop_plot =
      f"{OUTPUT_DIR}/gsea/{{contrast}}.{{confounder_handling}}.{{gsea}}_gsea_lollipop_plot.pdf",
  params:
