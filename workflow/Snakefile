  conda: "envs/combat_seq_correct.yaml"
  script: "scripts/combat_seq_correct.R"

def _counts_for_deseq2_fit(wildcards):
  correction = CORRECTION_FOR_CONFOUNDER_HANDLING.get(
    wildcards.confounder_handling
  )
  if correction == "combat_seq":
    return rules.combat_seq_correct.output.counts
  return rules.merge_counts.output.counts

# The confounders that are terms of the DESeq2 design of a given analysis:
# all of them unless ComBat-Seq has already removed some from the counts.
def _confounder_fields_for_handling(wildcards):
  correction = CORRECTION_FOR_CONFOUNDER_HANDLING.get(
    wildcards.confounder_handling
  )
  if correction == "combat_seq":
    return COMBAT_SEQ_RESIDUAL_CONFOUNDERS
  return CONFOUNDER_FIELD_NAMES

rule deseq2_fit:
  input:
    counts = _counts_for_deseq2_fit,
    coldata = rules.merge_counts.output.coldata,
    confounders_lib = workflow.source_path("scripts/lib/confounders.R"),
    # ^-- explicitly re-run upon code change
  params:
    reference_levels = REFERENCE_LEVELS,
    condition_fields = CONDITION_FIELD_NAMES,
    confounder_fields = _confounder_fields_for_handling,
    confounder_field_types = CONFOUNDER_FIELD_TYPES,
  output: dds_rds = f"{OUTPUT_DIR}/deseq2/{{confounder_handling}}_dds_object.rds",
  log: f"{OUTPUT_DIR}/logs/deseq2_fit.{{confounder_handling}}.log"
  conda: "envs/deseq2_fit.yaml"
  script: "scripts/deseq2_fit.R"

def _dds_for_contrast(wildcards):
  spec = CONTRAST_SPECS[wildcards.contrast]
  handling = wildcards.confounder_handling
  if spec["type"] == "pairwise":
    denom = spec["denominator"]
    return f"{OUTPUT_DIR}/deseq2/{handling}_dds_object_relevel_{denom}.rds"
  return f"{OUTPUT_DIR}/deseq2/{handling}_dds_object.rds"

rule deseq2_relevel:
  input:
    dds_rds = rules.deseq2_fit.output.dds_rds,
    confounders_lib = rules.deseq2_fit.input.confounders_lib,
    # ^-- explicitly re-run upon code change
  params:
    reference_factor = "{reference_factor}",
    confounder_fields = rules.deseq2_fit.params.confounder_fields,
    confounder_field_types = CONFOUNDER_FIELD_TYPES,
  output:
    dds_rds =
      f"{OUTPUT_DIR}/deseq2/{{confounder_handling}}_dds_object_relevel_{{reference_factor}}.rds",
  log:
    f"{OUTPUT_DIR}/logs/deseq2_relevel.{{confounder_handling}}.{{reference_factor}}.log"
  conda: "envs/deseq2_relevel.yaml"
  script: "scripts/deseq2_relevel.R"

rule deseq2_contrast:
  input: dds_rds = _dds_for_contrast,
  params:
    contrast_spec = lambda wc: CONTRAST_SPECS[wc.contrast],
    padj_threshold = config["deseq2"]["padj_threshold"],
    log2fc_threshold = config["deseq2"].get("log2fc_threshold", 0.0),
    expected_shrinkable = lambda wc: wc.contrast in SHRINKABLE_CONTRASTS,
  output:
    results = f"{OUTPUT_DIR}/deseq2/{{contrast}}.{{confounder_handling}}.results.tsv.gz",
  log: f"{OUTPUT_DIR}/logs/deseq2_contrast_{{contrast}}.{{confounder_handling}}.log"
  conda: "envs/deseq2_contrast.yaml"
  script: "scripts/deseq2_contrast.R"

rule vst_blind:
  input: dds_rds = rules.deseq2_fit.output.dds_rds,
  output: vst = f"{OUTPUT_DIR}/deseq2/{{confounder_handling}}_vst_blind.rds",
  log: f"{OUTPUT_DIR}/logs/vst_blind.{{confounder_handling}}.log"
