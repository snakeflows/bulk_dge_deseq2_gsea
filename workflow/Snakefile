# Rules #
#########

# TODO: Separate into separate `rules/*.smk` file(s)!

rule all:
  input:
    # DESeq2 results
    expand(f"{OUTPUT_DIR}/deseq2/{{confounder_handling}}_dds_object.rds",
           confounder_handling=ACTIVE_CONFOUNDER_HANDLING_METHODS),
    expand(f"{OUTPUT_DIR}/deseq2/{{contrast}}.{{confounder_handling}}.results.tsv.gz",
           contrast=CONTRAST_NAMES,
           confounder_handling=ACTIVE_CONFOUNDER_HANDLING_METHODS),
    # QC plots
    PCS_TO_PLOT_BY_CORRECTION_METHOD,
    expand(f"{OUTPUT_DIR}/qc/pc_field_association_{{correction}}_heatmap.pdf",
           correction=ACTIVE_CORRECTION_METHODS_QC),
    f"{OUTPUT_DIR}/qc/field_collinearity_heatmap.pdf",
    # QC tables
    expand(f"{OUTPUT_DIR}/qc/pc_field_association_{{correction}}.tsv.gz",
           correction=ACTIVE_CORRECTION_METHODS_QC),
    f"{OUTPUT_DIR}/qc/field_collinearity.tsv.gz",
    # DGE plots
    expand(f"{OUTPUT_DIR}/deseq2/{{contrast}}.{{confounder_handling}}.{{plot}}_plot_{{lfc}}.pdf",
           contrast=CONTRAST_NAMES,
           confounder_handling=ACTIVE_CONFOUNDER_HANDLING_METHODS,
           plot = { "ma", "volcano" }, lfc = { "shrunk", "unshrunk" }),
    # GSEA results
    expand(f"{OUTPUT_DIR}/gsea/{{contrast}}.{{confounder_handling}}.{{gsea}}_gsea_{{table}}.tsv.gz",
           contrast=CONTRAST_NAMES,
           confounder_handling=ACTIVE_CONFOUNDER_HANDLING_METHODS,
           gsea=GSEA_NAMES, table = { "all", "signif", "driver_genes" }),
    expand(f"{OUTPUT_DIR}/gsea/{{contrast}}.{{confounder_handling}}.{{gsea}}_gsea_signif_simplified.tsv.gz",
           contrast=CONTRAST_NAMES,
           confounder_handling=ACTIVE_CONFOUNDER_HANDLING_METHODS,
           gsea=GO_GSEA_NAMES),
    expand(f"{OUTPUT_DIR}/gsea/{{contrast}}.{{confounder_handling}}.{{gsea}}_gsea_{{plot}}.pdf",
           contrast=CONTRAST_NAMES,
           confounder_handling=ACTIVE_CONFOUNDER_HANDLING_METHODS,
           gsea=GSEA_NAMES,
           plot = { "plot", "ridge_plot", "lollipop_plot" }),
    # GSEA summary results (cross-contrast if multiple contrasts;
    # cross-confounder-handling if confounders are configured)
    *_AGGREGATE_GSEA_OUTPUTS, *_HANDLING_METHOD_GSEA_OUTPUTS,

rule merge_counts:
  input: count_files = COUNT_FILE_PATHS
  params:
    samples_info = SAMPLES_INFO,
    sample_fields = SAMPLE_FIELDS,
    file_to_samples = FILE_TO_SAMPLES,
    condition_fields = CONDITION_FIELD_NAMES,
    confounder_fields = CONFOUNDER_FIELD_NAMES,
  output:
    counts = f"{OUTPUT_DIR}/quantification_results/merged_counts.tsv.gz",
    coldata = f"{OUTPUT_DIR}/sample_annotation/coldata.tsv.gz",
  log: f"{OUTPUT_DIR}/logs/merge_counts.log"
  conda: "envs/merge_counts.yaml"
  script: "scripts/merge_counts.R"

rule combat_seq_correct:
  input:
    counts = rules.merge_counts.output.counts,
    coldata = rules.merge_counts.output.coldata,
    confounders_lib = workflow.source_path("scripts/lib/confounders.R"),
    # ^-- explicitly re-run upon code change
  params:
    confounder_fields = CONFOUNDER_FIELD_NAMES,
    confounder_field_types = CONFOUNDER_FIELD_TYPES,
    multi_confounder_strategy = COMBAT_SEQ_STRATEGY,
    discrete_confounder_fields = DISCRETE_CONFOUNDERS,
