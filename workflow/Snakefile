# Load configuration
configfile: "config/config.yaml"

# TODO: Separate into separate `rules/*.smk` file(s)!

OUTPUT_DIR = config["output_dir"]
DESIGN = config["design"]
LABEL_PATTERN = config["sample_label_pattern"]
CONDITION_PATTERN = config.get("sample_condition_pattern", LABEL_PATTERN)

# --- Parse the new files structure and flatten samples ---------------

FILES = config["files"]  # dict of {file_key: {path: ..., samples: {...}}}

# Flatten back to SAMPLES_INFO and track file origins
SAMPLES_INFO = {}
SAMPLE_TO_FILE = {}
FILE_TO_SAMPLES = {}

for file_key, file_info in FILES.items():
  file_path = file_info["path"]
  file_samples = file_info["samples"]

  for sample_id, label in file_samples.items():
    # Check for duplicate sample IDs across files (hard error)
    if sample_id in SAMPLES_INFO:
      raise ValueError(
        f"Sample '{sample_id}' appears in multiple file groups: "
        f"previously in '{SAMPLE_TO_FILE[sample_id]['file_key']}', "
        f"now in '{file_key}'. Samples must be unique across all files."
      )
    SAMPLES_INFO[sample_id] = label
    SAMPLE_TO_FILE[sample_id] = {"file_key": file_key, "path": file_path}
    FILE_TO_SAMPLES[file_key] = {
      "path": file_path,
      "samples": file_samples,
      "annotation_columns": file_info.get("annotation_columns", 0),
    }

# --- Parse every sample label into its fields -----------------------

LABEL_PARSER = parse.compile(LABEL_PATTERN)
SAMPLE_FIELDS = {}
for sample, label in SAMPLES_INFO.items():
  result = LABEL_PARSER.parse(label)
  if result is None:
    raise ValueError(
      f"Sample '{sample}' has label '{label}', which does not "
      f"match sample_label_pattern '{LABEL_PATTERN}'."
    )
  fields = result.named
  reconstructed = LABEL_PATTERN.format(**fields)
  if reconstructed != label:
    raise ValueError(
      f"Sample '{sample}': parsing '{label}' with pattern "
      f"'{LABEL_PATTERN}' gave fields {fields}, which do not "
      f"reconstruct the original label ('{reconstructed}'). "
      "A field value likely contains the pattern's own "
      "separator; check for an ambiguous split."
    )
  SAMPLE_FIELDS[sample] = fields

# --- Store original sample fields -----------------------------------

ORIGINAL_FIELD_NAMES = list(
    next(iter(SAMPLE_FIELDS.values())).keys()
)

# --- Add external sample metadata -----------------------------------

SAMPLE_METADATA = config.get("sample_metadata")

if SAMPLE_METADATA is not None:

    # Read and validate TSV header
    with open(
        SAMPLE_METADATA, "r", newline="", encoding="utf-8-sig"
    ) as metadata_file:
        reader = csv.reader(metadata_file, delimiter="\t")
        metadata_header = next(reader, [])

    # Check that the sample ID column exists
    if "sample_id" not in metadata_header:
        raise ValueError(
            "External sample metadata must contain a 'sample_id' column."
        )

    # Read external metadata
    EXTRA_METADATA = pd.read_csv(
        SAMPLE_METADATA,
        sep="\t",
        dtype=str,
        keep_default_na=False,
        encoding="utf-8-sig"
    )

    # Check for duplicated sample IDs
    if EXTRA_METADATA["sample_id"].duplicated().any():
        duplicated_samples = (
            EXTRA_METADATA.loc[
                EXTRA_METADATA["sample_id"].duplicated(keep=False), #keep=False marks all duplicates as True (even the first occurrence)
                "sample_id"
            ].unique().tolist() #Simplify the duplicated sample IDs to show unique values as a list to show in the error message
        )
        raise ValueError(
            f"External metadata contains duplicated sample IDs: "
            f"{duplicated_samples}."
        )

    # Get sample IDs from both sources
    EXISTING_SAMPLES = set(SAMPLE_FIELDS.keys())
    METADATA_SAMPLES = set(EXTRA_METADATA["sample_id"])

    # Check that samples in external metadata match those defined in the current config['files'] section
    missing_samples = EXISTING_SAMPLES - METADATA_SAMPLES
    unknown_samples = METADATA_SAMPLES - EXISTING_SAMPLES
    if missing_samples or unknown_samples:
        raise ValueError(
            "External metadata sample IDs do not match the samples "
            "defined in config['files'].\n"
            f"Missing samples: {sorted(missing_samples)}\n"
            f"Unknown samples: {sorted(unknown_samples)}"
        )

    # Identify additional metadata columns
    EXTRA_FIELD_NAMES = [
        col for col in EXTRA_METADATA.columns
        if col != "sample_id"
    ]

    # Check that additional fields do not already exist
    duplicated_fields = (
        set(EXTRA_FIELD_NAMES) & set(ORIGINAL_FIELD_NAMES)
    )
    if duplicated_fields:
        raise ValueError(
            f"External metadata contains field(s) already defined in "
            f"`sample_label_pattern`: {sorted(duplicated_fields)}."
        )

    # Set sample_id as the DataFrame index
    EXTRA_METADATA = EXTRA_METADATA.set_index("sample_id")

    # Add external metadata to SAMPLE_FIELDS
    for sample_id in SAMPLE_FIELDS:
        for field_name in EXTRA_FIELD_NAMES:
            SAMPLE_FIELDS[sample_id][field_name] = (
                EXTRA_METADATA.at[sample_id, field_name]
            )
    print(
        f"[Sample Metadata] Added {len(EXTRA_FIELD_NAMES)} "
        f"external field(s): {EXTRA_FIELD_NAMES}"
    )

# --- Update field names ---------------------------------------------

FIELD_NAMES = list(
    next(iter(SAMPLE_FIELDS.values())).keys()
)

# --- Split condition and confounder fields --------------------------
CONDITION_FIELD_NAMES = [
  name for _, name, _, _ in string.Formatter().parse(CONDITION_PATTERN)
  if name
]
unknown_condition_fields = set(CONDITION_FIELD_NAMES) - set(FIELD_NAMES)
if unknown_condition_fields:
  raise ValueError(
    f"`sample_condition_pattern` references field(s) not produced by "
    f"`sample_label_pattern`: {sorted(unknown_condition_fields)}."
  )

CONFOUNDER_FIELD_TYPES = DESIGN.get("confounders", {})
CONFOUNDER_FIELD_NAMES = list(CONFOUNDER_FIELD_TYPES.keys())
_ALLOWED_CONFOUNDER_TYPES = ("binary", "categorical", "ordinal", "continuous")
invalid_confounder_types = {
  f: t for f, t in CONFOUNDER_FIELD_TYPES.items()
  if t not in _ALLOWED_CONFOUNDER_TYPES
}
if invalid_confounder_types:
  raise ValueError(
    f"`design.confounders` declares unsupported type(s): "
    f"{invalid_confounder_types}. Allowed: {list(_ALLOWED_CONFOUNDER_TYPES)}."
  )
unknown_confounder_fields = set(CONFOUNDER_FIELD_NAMES) - set(FIELD_NAMES)
if unknown_confounder_fields:
  raise ValueError(
    f"`design.confounders` references field(s) not produced by "
    f"`sample_label_pattern`: {sorted(unknown_confounder_fields)}."
  )

overlap = set(CONDITION_FIELD_NAMES) & set(CONFOUNDER_FIELD_NAMES)
if overlap:
  raise ValueError(
    f"Field(s) {sorted(overlap)} are claimed by both "
    f"`sample_condition_pattern` and `design.confounders`; a field must "
    f"be exactly one of the two."
  )
unclassified_fields = (
  set(FIELD_NAMES) - set(CONDITION_FIELD_NAMES) - set(CONFOUNDER_FIELD_NAMES)
)
PCA_LABEL_FIELD = config["pca"].get("label", None)
if PCA_LABEL_FIELD is not None:
  if PCA_LABEL_FIELD not in FIELD_NAMES:
    raise ValueError(
      f"`pca.label` references field not produced by `sample_label_pattern`: "
      f"{PCA_LABEL_FIELD}."
    )
  unclassified_fields = unclassified_fields - {PCA_LABEL_FIELD}

if unclassified_fields:
  warnings.warn(
    f"Fields {sorted(unclassified_fields)} are retained in colData() for "
    "diagnostics only and are excluded from the design matrix."
  )

# SAMPLES_INFO currently holds the raw sample_label_pattern string
# (needed just above to parse SAMPLE_FIELDS). Replace it with the
# derived condition string: everything downstream -- ALL_CONDITIONS,
# contrast validation, CONDITION_FIELDS, and the samples_info param
# handed to deseq2_fit.R (which becomes coldata$condition) -- must
# see only the biological condition, never a confounder-inclusive
# label.
for sample in SAMPLES_INFO:
  fields = SAMPLE_FIELDS[sample]
  SAMPLES_INFO[sample] = CONDITION_PATTERN.format(
    **{f: fields[f] for f in CONDITION_FIELD_NAMES}
  )

# --- Auto-detect field types ---------------------------------------
def infer_field_type(values):
  """
  Infer field type from unique values.

  Inspired by the `smartcor` R package's intelligent variable classification,
  but extended with early detection of uninformative fields (constant and
  identifier types, absent from smartcor).

  Constant fields (single value across all samples) provide no information.
  Identifiers (sample names, run IDs, etc.) with 100% unique values create
  spurious correlations and η² = 1 in ANOVA. Detecting both at the Snakefile
  level allows downstream diagnostics (PC-field association matrix, field
  collinearity matrix) to skip them cleanly.

  Rules applied in order:
  1. Constant (1 unique value) -> "constant"
  2. Identifier (100% unique) -> "identifier"
  3. Binary (exactly 2 unique) -> "binary"
  4. Character/string vector -> "categorical"
  5. Logical -> "binary"
  6. Numeric with <= 10 unique whole numbers -> "ordinal"
  7. Other numeric -> "continuous"
  """

  if not values:
    return "categorical"  # default for empty

  unique_vals = set(values)

  # Rule 0: Constant (only 1 unique value)
  if len(unique_vals) == 1:
    return "constant"

  # Rule 1: Identifier (100% unique across all samples)
  if len(unique_vals) == len(values):
    return "identifier"

  # Rule 2: Binary (exactly 2 unique values)
  if len(unique_vals) == 2:
    return "binary"

  # Rule 3: Character/string (see below)

  # Rule 4: Logical/boolean
  # Handled by rule 2 already.

  # Try numeric coercion for rules 5 and 6. This must run before falling
  # back to "categorical": every value here is a Python str (parsed from a
  # sample label), so a numeric-looking field (e.g. age) is also a str --
  # attempting numeric coercion first is what actually distinguishes it
  # from a genuinely non-numeric label.
  try:
    numeric_vals = [float(v) for v in unique_vals]
    # Rule 5: Numeric with <= 10 unique whole numbers
    if len(unique_vals) <= 10 and all(v == int(v) for v in numeric_vals):
      return "ordinal"
    # Rule 6: Other numeric
    return "continuous"
  except (ValueError, TypeError):
    # Rule 3 (evaluated here, after numeric coercion fails): categorical
    return "categorical"

# For retained fields not in CONFOUNDER_FIELD_TYPES, auto-detect type
FIELD_TYPES = {}

# Start with explicit confounder types
if "confounders" in DESIGN:
  FIELD_TYPES.update(DESIGN["confounders"])

# Invert: collect all values per field across all samples
_FIELD_VALUES = {}
for sample_id, field_dict in SAMPLE_FIELDS.items():
  for field_name, field_value in field_dict.items():
    if field_name not in _FIELD_VALUES:
      _FIELD_VALUES[field_name] = []
    _FIELD_VALUES[field_name].append(field_value)

# Auto-detect remaining fields
for field_name, field_values in _FIELD_VALUES.items():
  if field_name not in FIELD_TYPES:
    detected_type = infer_field_type(field_values)
    FIELD_TYPES[field_name] = detected_type
    print(f"[Type Detection] Field '{field_name}': auto-detected as "
          f"'{detected_type}'")

# Cleanup
del _FIELD_VALUES

# --- Batch-correction stages and diagnostics ------------------------

CORRECTION_METHODS = ["uncorrected", "combat_seq"]  # produce real DGE output
CORRECTION_METHODS_QC = CORRECTION_METHODS + ["limma"]  # + diagnostics-only
# Without confounders there is nothing to correct for: only the uncorrected
# stage is ever requested (batch_correct.R additionally refuses to run).
ACTIVE_CORRECTION_METHODS_QC = (
  CORRECTION_METHODS_QC if CONFOUNDER_FIELD_NAMES else ["uncorrected"]
)

# --- Confounder handling ---------------------------------------------
# The `{confounder_handling}` wildcard labels every real-analysis output
# (DESeq2 fit, contrasts, DGE plots, GSEA) with how confounders were dealt
# with. One value per correction method that produces DGE output, plus
# NO_CONFOUNDERS for runs that have no confounders to deal with at all.
CONFOUNDER_HANDLING_FOR_CORRECTION = {
  "uncorrected": "confounders_modelled",
  "combat_seq": "confounders_corrected",
}
CORRECTION_FOR_CONFOUNDER_HANDLING = {
  v: k for k, v in CONFOUNDER_HANDLING_FOR_CORRECTION.items()
}
CONFOUNDER_HANDLING_METHODS = list(CONFOUNDER_HANDLING_FOR_CORRECTION.values())
NO_CONFOUNDERS = "no_confounders"
ACTIVE_CONFOUNDER_HANDLING_METHODS = (
  CONFOUNDER_HANDLING_METHODS if CONFOUNDER_FIELD_NAMES else [NO_CONFOUNDERS]
)

# The diagnostics (QC) always look at the uncorrected counts, i.e. at the
# dds that models the confounders (if there are any). Rules without a
# {confounder_handling} wildcard of their own cannot use
# `rules.deseq2_fit.output`, so they take these fully resolved paths.
QC_CONFOUNDER_HANDLING = (
  CONFOUNDER_HANDLING_FOR_CORRECTION["uncorrected"]
  if CONFOUNDER_FIELD_NAMES else NO_CONFOUNDERS
)
QC_DDS = f"{OUTPUT_DIR}/deseq2/{QC_CONFOUNDER_HANDLING}_dds_object.rds"
QC_VST_BLIND = f"{OUTPUT_DIR}/deseq2/{QC_CONFOUNDER_HANDLING}_vst_blind.rds"

# --- ComBat-Seq ----------------------------------------------------------
# How combat_seq_correct.R deals with more than one confounder (documented
# there). There is no on/off switch: ComBat-Seq runs iff `design.confounders`
# is not empty.
_COMBAT_SEQ_STRATEGIES = ("sequential", "preserve_extra", "composite")
COMBAT_SEQ_STRATEGY = DESIGN.get("combat_seq", {}).get(
  "multi_confounder_strategy", "sequential"
)
if COMBAT_SEQ_STRATEGY not in _COMBAT_SEQ_STRATEGIES:
  raise ValueError(
    f"`design.combat_seq.multi_confounder_strategy` is "
    f"'{COMBAT_SEQ_STRATEGY}'. Allowed: {list(_COMBAT_SEQ_STRATEGIES)}."
  )

# Confounders that ComBat-Seq leaves in the counts: it can only correct for
# discrete fields (`batch` is strictly discrete), so continuous fields are
# merely preserved, and with `preserve_extra` all but the first discrete
# field are. The DESeq2 fit on the corrected counts has to keep modelling
# them, or nothing would control for them anywhere. (Declaration order, like
# in combat_seq_correct.R; if there is no discrete field, that script stops.)
DISCRETE_CONFOUNDERS = [
  f for f in CONFOUNDER_FIELD_NAMES if CONFOUNDER_FIELD_TYPES[f] != "continuous"
]
if COMBAT_SEQ_STRATEGY == "sequential":
  COMBAT_SEQ_RESIDUAL_CONFOUNDERS = [
    f for f in CONFOUNDER_FIELD_NAMES if f not in DISCRETE_CONFOUNDERS
  ]
elif COMBAT_SEQ_STRATEGY == "preserve_extra":
  COMBAT_SEQ_RESIDUAL_CONFOUNDERS = [
    f for f in CONFOUNDER_FIELD_NAMES if f not in DISCRETE_CONFOUNDERS[:1]
  ]
else:  # composite: one batch out of all (necessarily discrete) confounders
  COMBAT_SEQ_RESIDUAL_CONFOUNDERS = []

# --- Retrieve the specific plots to create from the config file -------

for c in ACTIVE_CORRECTION_METHODS_QC:
  if c not in config["pca"].setdefault("pc_pairs", {}):
    config["pca"]["pc_pairs"][c] = ["PC1_PC2"]  # default if not specified

PCS_TO_PLOT_BY_CORRECTION_METHOD = [
  pca_plot for correction, pcs in config["pca"]["pc_pairs"].items()
  for pca_plot in expand(
    f"{OUTPUT_DIR}/qc/plot_pca_{{correction}}_{{pcs}}.pdf",
    correction=correction, pcs=pcs,
  )
]

# --- Colour and palette settings for the gradient pca_plot -------

if "color" not in config["pca"] and "colour" not in config["pca"]:
  raise ValueError(
    f"`pca.colour/color` is not specified in the config file. Please specify a colour variable for PCA plots."
  )  
else:
  if config["pca"].get("colour", None) is not None and config["pca"].get("color", None) is not None:
    raise ValueError(
      f"`pca.colour` and `pca.color` are both specified in the config file. Please specify only one of them."
    )
  else:
    colour_or_color_config = config["pca"].get("colour", {}) or config["pca"].get("color", {})
    pca_colour_setting = {}
    if colour_or_color_config.get("field", None) is None:
      raise ValueError(
        f"`pca.colour/color` is specified but no field is provided. Please specify a field for PCA plots."
      )
    else:
      if "label" not in colour_or_color_config:
        raise ValueError(
          f"`pca.colour/color.label` is not specified in the config file. Please specify a label for PCA plots."
        )
      else:
        if "palette" in colour_or_color_config:
          if len({"low", "mid", "high"}.intersection(colour_or_color_config)):
            raise ValueError(
              f"`pca.colour.palette` is specified but one or more parameters are also specified. Please specify either a palette or the individual parameters."
            )
          else:
            pca_colour_setting["palette"] = colour_or_color_config["palette"]
        else:
          pca_colour_setting["high"] = colour_or_color_config.get("high","red")
          pca_colour_setting["low"] = colour_or_color_config.get("low","blue")
   
          if "mid" in colour_or_color_config:
            pca_colour_setting["mid"] = colour_or_color_config["mid"]

# --- Check if shape config exists for PCA plots -------

if "shape" not in config["pca"]:
  raise ValueError(
    f"`pca.shape` is not specified in the config file. Please specify a shape variable for PCA plots."
  )
else:
  if config["pca"].get("shape", None) is None:
    raise ValueError(
      f"`pca.shape` is specified but no variable is provided. Please specify a field and a label for PCA plots."
    )
  else:
    if "field" not in config["pca"]["shape"]:
      raise ValueError(
        f"`pca.shape.field` is not specified in the config file. Please specify a field for PCA plots."
      )
    if "label" not in config["pca"]["shape"]:
      raise ValueError(
        f"`pca.shape.label` is not specified in the config file. Please specify a label for PCA plots."
      )

# --- Resolve contrasts: numerator/denominator sugar -> groups -------

ALL_CONDITIONS = set(SAMPLES_INFO.values())
CONTRASTS = {}
for name, spec in config["contrasts"].items():
  groups = spec["groups"] if "groups" in spec else {
    spec["numerator"]: 1, spec["denominator"]: -1
  }
  unknown = set(groups) - ALL_CONDITIONS
  if unknown:
    raise ValueError(
      f"Contrast '{name}' references condition(s) not present "
      f"in config.yaml 'samples': {sorted(unknown)}. Available: "
      f"{sorted(ALL_CONDITIONS)}."
    )
  CONTRASTS[name] = groups

CONTRAST_NAMES = list(CONTRASTS.keys())
ALL_CONDITIONS = set(SAMPLES_INFO.values())
CONTRAST_SPECS = {}
for name, spec in config["contrasts"].items():
  if "numerator" in spec and "denominator" in spec:
    referenced = {spec["numerator"], spec["denominator"]}
    contrast_type = "pairwise"
  else:
    referenced = set(spec["groups"])
    contrast_type = "groups"

  unknown = referenced - ALL_CONDITIONS
  if unknown:
    raise ValueError(
      f"Contrast '{name}' references condition(s) not present "
      f"in config.yaml 'samples': {sorted(unknown)}. Available: "
      f"{sorted(ALL_CONDITIONS)}."
    )
  CONTRAST_SPECS[name] = {"type": contrast_type, **spec}

CONTRAST_NAMES = list(CONTRAST_SPECS.keys())

PAIRWISE_CONTRASTS = {
  n: s for n, s in CONTRAST_SPECS.items() if s["type"] == "pairwise"
}
REFERENCE_FACTORS = sorted({
  s["denominator"] for s in PAIRWISE_CONTRASTS.values()
})

configured_ref_levels = DESIGN.get("reference_levels", {})
unknown_ref_fields = set(configured_ref_levels) - set(FIELD_NAMES)
if unknown_ref_fields:
  raise ValueError(
    f"design.reference_levels references field(s) not produced "
    f"by sample_label_pattern: {sorted(unknown_ref_fields)}."
  )

REFERENCE_LEVELS = {}
for field in FIELD_NAMES:
  observed = sorted({v[field] for v in SAMPLE_FIELDS.values()})
  REFERENCE_LEVELS[field] = configured_ref_levels.get(field, observed[0])

# --- Build count file list for Snakemake dependency tracking -----------

COUNT_FILE_PATHS = sorted(
  set(file_info["path"] for file_info in FILES.values())
)

# --- Which coefficients actually exist, given the observed ------
# --- (possibly incomplete) factorial. ----------------------------

CONDITION_FIELDS = {
  cond: {f: SAMPLE_FIELDS[sample][f] for f in CONDITION_FIELD_NAMES}
  for sample, cond in SAMPLES_INFO.items()
}

def group_for(assignment):
  for cond, fields in CONDITION_FIELDS.items():
    if all(fields[f] == assignment[f] for f in CONDITION_FIELD_NAMES):
      return cond
  return None

def canonical_patterns():
  patterns = []
  for r in range(1, len(CONDITION_FIELD_NAMES) + 1):
    for term in itertools.combinations(CONDITION_FIELD_NAMES, r):
      non_ref_levels = {
        f: [v for v in sorted({fl[f] for fl in CONDITION_FIELDS.values()})
            if v != REFERENCE_LEVELS[f]]
        for f in term
      }
      for combo in itertools.product(*non_ref_levels.values()):
        chosen = dict(zip(term, combo))
        pattern, complete = {}, True
        for corner in itertools.product([False, True], repeat=len(term)):
          assignment = {f: REFERENCE_LEVELS[f] for f in CONDITION_FIELD_NAMES}
          for f, at_chosen in zip(term, corner):
            assignment[f] = chosen[f] if at_chosen else REFERENCE_LEVELS[f]
          cond = group_for(assignment)
          if cond is None:
            complete = False
            break
          sign = (-1) ** (len(term) - sum(corner))
          pattern[cond] = pattern.get(cond, 0) + sign
        if complete:
          patterns.append(pattern)
  return patterns

_CANONICAL_PATTERNS = canonical_patterns()

def contrast_is_shrinkable(spec):
  if spec["type"] == "pairwise":
    return True
  return spec["groups"] in _CANONICAL_PATTERNS

SHRINKABLE_CONTRASTS = [
  name for name, spec in CONTRAST_SPECS.items()
  if contrast_is_shrinkable(spec)
]

GENE_LABEL = config.get("gene_label", None)
GENES_OF_INTEREST = config.get("genes_of_interest", None)
GSEA_NAMES = list(config["gsea"].keys())
GO_GSEA_NAMES = [
    n for n in GSEA_NAMES if config["gsea"][n]["database"] == "GO"
]
OTHER_GSEA_NAMES = [
    n for n in GSEA_NAMES if config["gsea"][n]["database"] != "GO"
]

HEATMAP_TOP_N = config["gsea_summary"]["heatmap_top_n"]


# Only aggregate GSEA results if there's more than one contrast
_GSEA_SUMMARY_OUTPUT_SUFFIXES = {"summary.tsv.gz", "summary_heatmap.pdf",
                                 "jaccard.tsv.gz"}
_AGGREGATE_GSEA_OUTPUTS = []
if len(CONTRAST_NAMES) > 1:
  _AGGREGATE_GSEA_OUTPUTS = expand(
    f"{OUTPUT_DIR}/gsea/{{gsea}}.{{confounder_handling}}.gsea_{{suffix}}",
    gsea=GSEA_NAMES, confounder_handling=ACTIVE_CONFOUNDER_HANDLING_METHODS,
    suffix=_GSEA_SUMMARY_OUTPUT_SUFFIXES,
  )

# Only compare GSEA results if several confounder handling approaches are
# used
_HANDLING_METHOD_GSEA_OUTPUTS = []
if len(ACTIVE_CONFOUNDER_HANDLING_METHODS) > 1:
  _HANDLING_METHOD_GSEA_OUTPUTS = expand(
    f"{OUTPUT_DIR}/gsea/{{contrast}}.{{gsea}}" +
      ".confounder_handling_comparison.gsea_{suffix}",
    contrast=CONTRAST_NAMES, gsea=GSEA_NAMES,
    suffix=_GSEA_SUMMARY_OUTPUT_SUFFIXES,
  )


########################
# Wildcard constraints #
########################

wildcard_constraints:
  contrast = "|".join(re.escape(c) for c in CONTRAST_NAMES),
  reference_factor = "|".join(re.escape(r) for r in REFERENCE_FACTORS),
  correction = "|".join(ACTIVE_CORRECTION_METHODS_QC),
  confounder_handling = "|".join(ACTIVE_CONFOUNDER_HANDLING_METHODS),
  lfc_type = "unshrunk|shrunk",
  gsea = "|".join(re.escape(a) for a in GSEA_NAMES),
  pcs = r"PC([1-9][0-9]*)_PC(?!\1$)[1-9][0-9]*"

