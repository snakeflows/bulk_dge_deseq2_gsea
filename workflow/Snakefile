# Enable setting a minimum Snakemake version supported by the workflow.
from snakemake.utils import min_version

# This workflow specifies the use of conda via the `software-deployment-method`
# parameter that was introduced in Snakemake 8.
# It was tested with version 9.27.0 but a search through the changelog for
# features added in-between did not reveal anything that should affect this
# workflow.
min_version("8.0.0")


