  script: "scripts/vst_blind.R"

rule batch_correct:
  wildcard_constraints:
    correction = "|".join(
      c for c in CORRECTION_METHODS_QC if c not in CORRECTION_METHODS
    )
  input:
    dds_rds = QC_DDS,
    vst = QC_VST_BLIND,
  output: vst = f"{OUTPUT_DIR}/deseq2/vst_corrected_{{correction}}.rds",
  log: f"{OUTPUT_DIR}/logs/batch_correct_{{correction}}.log"
  conda: "envs/batch_correct.yaml"
  script: "scripts/batch_correct.R"

def _assay_for_pca(wildcards):
  if wildcards.correction == "uncorrected":
    return QC_VST_BLIND
  if wildcards.correction in CORRECTION_METHODS:
    # Corrected counts: the blind VST of the dds fit on them.
    handling = CONFOUNDER_HANDLING_FOR_CORRECTION[wildcards.correction]
    return f"{OUTPUT_DIR}/deseq2/{handling}_vst_blind.rds"
  return f"{OUTPUT_DIR}/deseq2/vst_corrected_{wildcards.correction}.rds"

rule analysis_pca:
  input:
    dds_rds = QC_DDS,
    assay = _assay_for_pca,

  output:
    scores = f"{OUTPUT_DIR}/qc/analysis_pca_{{correction}}_scores.rds",
  log: f"{OUTPUT_DIR}/logs/analysis_pca_{{correction}}.log"
  conda: "envs/analysis_pca.yaml"
  script: "scripts/analysis_pca.R"

rule plot_pca:
  input:
    dds_rds = QC_DDS,
    scores = rules.analysis_pca.output.scores,
    plot_theme_lib = workflow.source_path("scripts/lib/plot_theme.R"),
    # ^-- explicitly re-run upon code change

  output:
    pca = f"{OUTPUT_DIR}/qc/plot_pca_{{correction}}_{{pcs}}.pdf"

  params:
    colour_setting = pca_colour_setting,
    colour_field = config["pca"]["colour"]["field"],
    colour_label = config["pca"]["colour"].get("label", config["pca"]["colour"]["field"]),
    shape = config["pca"]["shape"],
    label = PCA_LABEL_FIELD,
    title_suffix = lambda wc: (
      "" if wc.correction == "uncorrected" else f" ({wc.correction}-corrected)"
    ),
  log: f"{OUTPUT_DIR}/logs/plot_pca_{{correction}}_{{pcs}}.log"
  conda: "envs/plot_pca.yaml"
  script: "scripts/plot_pca.R"

